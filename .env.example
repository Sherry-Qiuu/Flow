# Copy this file to .env on the device. Never commit .env.
# Real values stay only in /opt/flow/.env (mode 600).
# Use FLOW_HAL=mock or auto only for bench testing without hardware.

FLOW_HAL=real

# Hardware mapping from docs/hardware-tutorials/A-接线总图与引脚分配.md
FLOW_PHONE_PRESENT_PIN=27
FLOW_INA219_ADDR=0x40
FLOW_PHONE_POLL_MS=100

# Fill these after install; leave empty until the provider is configured.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
DASHSCOPE_API_KEY=
