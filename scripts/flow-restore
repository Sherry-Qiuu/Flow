#!/usr/bin/env bash
# Restore Flow's SQLite database from a T10 backup.
# Stop flow-backend first: flow-restore --latest
set -euo pipefail

FLOW_HOME="${FLOW_HOME:-/opt/flow}"
PYTHON="${FLOW_HOME}/.venv/bin/python"
if [ ! -x "${PYTHON}" ]; then
  PYTHON="python3"
fi

exec env PYTHONPATH="${FLOW_HOME}/app" "${PYTHON}" -m data.restore "$@"
